# Polymarket
POLYMARKET_PRIVATE_KEY=           # 你的 EOA 钱包私钥 (0x开头)
POLYMARKET_API_KEY=               # 自动生成 (运行 python scripts/setup_api.py)
POLYMARKET_API_SECRET=            # 自动生成
POLYMARKET_API_PASSPHRASE=        # 自动生成
POLYMARKET_FUNDER=                # 你的钱包地址 (0x开头)

# Database
DATABASE_URL=sqlite:///./polyhunter.db

# Risk Management
RISK_MAX_SINGLE_BET_PCT=10
RISK_MAX_DAILY_LOSS_PCT=5
RISK_MAX_POSITION_PCT=20
RISK_MIN_EDGE_PCT=1
RISK_MAX_POSITIONS=10
RISK_EXPIRY_BUFFER_HOURS=24

# Bitget
BITGET_API_KEY=                  # Bitget API Key
BITGET_SECRET_KEY=               # Bitget Secret Key
BITGET_PASSPHRASE=               # Bitget API Passphrase
BITGET_ACCOUNT_TYPE=spot         # "spot" or "futures"
BITGET_SYMBOLS=BTCUSDT,ETHUSDT   # comma-separated trading pairs
BITGET_DEFAULT_SIZE_USD=10       # default trade size in USD
BITGET_MAX_POSITION_USD=100      # max position per symbol
BITGET_LEVERAGE=1                # futures leverage (1 = no leverage)
BITGET_AUTO_TRADE_ENABLED=false  # enable auto-trading
BITGET_MIN_CONFIDENCE=60         # min signal confidence (0-100)
BITGET_MIN_EDGE_PCT=0.5          # min edge percentage

# Price Monitor
MONITOR_ALERT_CHANGE_PCT=2.0     # price change % to trigger alert

# Strategies
STRATEGY_EMA_FAST=9
STRATEGY_EMA_SLOW=21
STRATEGY_RSI_PERIOD=14
STRATEGY_RSI_OVERBOUGHT=70
STRATEGY_RSI_OVERSOLD=30
STRATEGY_BB_PERIOD=20
STRATEGY_BB_STD=2.0

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 2: AI (via OpenRouter)
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4
